# Local-only paper simulator. No live mode or brokerage credentials are accepted.
PAPER_DB_PATH=data/paper.db
# Used only when the database is first created; reset always uses persisted principal.
PAPER_INITIAL_CASH=10000
PAPER_FIXED_FEE=0.01
PAPER_FEE_RATE=0.0001
PAPER_SLIPPAGE_BPS=5
PAPER_MAX_TRADE_PCT=0.10
PAPER_MAX_SYMBOL_PCT=0.25
PAPER_MAX_TOTAL_PCT=0.80
PAPER_QUOTE_MAX_AGE_SECONDS=180
# Operator-reviewed ordinary stocks for metadata that is otherwise ambiguous.
# Metadata currency/exchange/type and derivative exclusion still apply.
PAPER_APPROVED_SYMBOLS=AAPL,MSFT
